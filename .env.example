# Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail API OAuth (use: bun run gmail-auth after filling client id/secret)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional overrides (defaults: support@kino.pub and Kinopub subject)
# GMAIL_FROM=
# GMAIL_SUBJECT=

# Poll interval in ms (default 30000, minimum 5000)
# POLL_INTERVAL_MS=30000

# OAuth helper only: loopback port (default 3939)
# OAUTH_PORT=3939
